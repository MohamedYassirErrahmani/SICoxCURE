cat("\n══════════════════════════════════════════════\n")
cat("  WORKFLOW B : fonctions séparées\n")
cat("══════════════════════════════════════════════\n\n")
# Etape 1 : sic_fit()
cat("--- Etape 1 : sic_fit() ---\n\n")
fit_B <- sic_fit(Y, delta, X, Z,
h_step  = 0.05,
verbose = 1L)
# Etape 2 : bootstrap_se()
cat("\n--- Etape 2 : bootstrap_se() ---\n\n")
se_B <- bootstrap_se(fit_B,
B        = 50L,
parallel = FALSE,
seed     = 42L,
verbose  = TRUE)
print(se_B)
# Etape 3 : summary()
