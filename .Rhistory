summary(fit_B, se = se_B)
# Etape 4 : plot_link() + plot_survival()
cat("\n--- Etape 4 : plot_link() + plot_survival() ---\n")
par(mfrow = c(1, 2))
plot_link(fit_B,
main = "data1b - Link function g",
col  = "darkblue")
plot_survival(fit_B,
newZ         = matrix(c(0, 1), ncol = 1),
group_labels = c("Z = 0", "Z = 1"),
cols         = c("red", "blue"),
main         = "data1b - S_u(t|z)")
par(mfrow = c(1, 1))
# Etape 5 : predict() sur nouvelles données
cat("\n--- Etape 5 : predict() ---\n\n")
set.seed(99)
X_new <- matrix(rnorm(10 * 4), 10, 4)
Z_new <- matrix(rbinom(10, 1L, 0.6), 10, 1)
p_new <- predict(fit_B,
newX = X_new,
newZ = Z_new,
type = "incidence")
?predict
class(fit_B)
cat("Incidence sur 10 nouvelles observations :\n")
print(round(p_new, 4))
pred_all <- predict(fit_B,
newX = X_new,
newZ = Z_new,
type = "all")
cat(sprintf("\nSurvie moyenne à t=1 : %.3f\n",
mean(pred_all$survival[,
which.min(abs(pred_all$t_eval - 1))])))
print(round(pred_all, 4))
# Tableau résumé par patient
tab <- data.frame(
Patient   = 1:10,
Index     = round(pred_all$index, 4),
Incidence = round(pred_all$incidence, 4),
Su_t1     = round(pred_all$latency[,
which.min(abs(pred_all$t_eval-1))], 4),
S_t1      = round(pred_all$survival[,
which.min(abs(pred_all$t_eval-1))], 4)
)
colnames(tab) <- c("Patient", "Index (gamma'X)",
"p(x)", "Su(t=1|z)", "S(t=1|x,z)")
print(tab)
print(round(p_new, 4))
print(round(pred_all$index, 4))
print(round(pred_all$t_eval, 4))
print(round(pred_all$survival, 4))
print(round(pred_all$latency, 4))
print(round(pred_all$incidence, 4))
print(round(pred_all$latency, 4))
print(round(pred_all$latency, 10))
print(tab)
# Tableau résumé par patient
tab <- data.frame(
Patient   = 1:10,
Index     = round(pred_all$index, 4),
Incidence = round(pred_all$incidence, 4),
Su_t1     = round(pred_all$latency[,
which.min(abs(pred_all$t_eval-0.5))], 4),
S_t1      = round(pred_all$survival[,
which.min(abs(pred_all$t_eval-0.5))], 4)
)
colnames(tab) <- c("Patient", "Index (gamma'X)",
"p(x)", "Su(t=1|z)", "S(t=1|x,z)")
print(tab)
temps <- c(0.5, 1, 2, 5, 10,15,20,25)
# Trouver les indices correspondants
idx_temps <- sapply(temps, function(t)
which.min(abs(pred_all$t_eval - t)))
# Tableau survie globale
tab_S <- data.frame(
round(pred_all$survival[, idx_temps], 4)
)
colnames(tab_S) <- paste0("S(t=", temps, ")")
rownames(tab_S) <- paste("Patient", 1:10)
print(tab_S)
pred_all <- predict(fit_B,
newX = X_new,
newZ = Z_new,
t_eval = c(0.5, 1, 2, 5, 10),
type = "all")
print(round(pred_all$index, 4))
print(round(pred_all$t_eval, 4))
print(round(pred_all$survival, 4))
print(round(pred_all$latency, 4))
print(round(pred_all$incidence, 4))
