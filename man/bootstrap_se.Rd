p     <- 1 / (1 + exp(-X \%*\% c(1, -0.5, 0.3, -0.2)))
B_ind <- rbinom(n, 1L, p)
T0    <- ifelse(B_ind == 1, rexp(n, 0.5), Inf)
C     <- rexp(n, 0.3)
Y     <- pmin(T0, C)
delta <- as.integer(T0 <= C & T0 < Inf)

