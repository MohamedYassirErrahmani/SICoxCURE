Package: SICoxCURE
Type: Package
Title: Single-Index/Cox Mixture Cure Model
Version: 0.1.1
Authors@R: c(
    person("Mohamed Yassir", "Errahmani",
           role = c("aut", "cre"),
           email = "mohamed-yassir.errahmani@umontpellier.fr",
           comment = c(ORCID = "")),
    person("Mailis", "Amico",
           role = "aut",
           comment = c(ORCID = "0000-0003-2630-8938")),
    person("Ingrid", "Van Keilegom",
           role = "aut",
           comment = c(ORCID = "0000-0001-8827-7642")),
